{
    "name": "coffee-pos/backend",
    "type": "project",
    "description": "Cloud API for the Coffee & Restaurant POS platform",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/reverb": "^1.0",
        "laravel/horizon": "^5.24",
        "spatie/laravel-permission": "^6.9",
        "stripe/stripe-php": "^15.0",
        "predis/predis": "^2.2",
        "league/csv": "^9.16"
    },
    "require-dev": {
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.30",
        "phpunit/phpunit": "^11.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "php artisan test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
