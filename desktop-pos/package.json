{
  "name": "coffee-pos-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite --config src/renderer/vite.config.ts\" \"electron .\"",
    "build": "vite build --config src/renderer/vite.config.ts && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^11.1.2",
    "axios": "^1.7.4",
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "vite": "^5.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.brewline.pos.desktop",
    "productName": "Brewline POS",
    "files": ["src/main/**/*", "dist/**/*"],
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
